<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />

    <!-- Статус -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⏳ Ожидание превышения веса..."
        android:textSize="16sp"
        android:padding="8dp" />

    <!-- Вес и расстояние -->
    <TextView
        android:id="@+id/tvWeightDistance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚖️: --, 📏: --"
        android:textSize="18sp"
        android:padding="8dp"
        android:textStyle="bold" />

    <!-- RAW данные -->
    <TextView
        android:id="@+id/tvRawData"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📨 Ожидание данных..."
        android:textSize="14sp"
        android:padding="8dp"
        android:maxLines="2"
        android:ellipsize="end" />

    <!-- Кнопки управления -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btnScan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🔍"
            android:textSize="24sp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🔗"
            android:textSize="24sp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnDisconnect"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="❌"
            android:textSize="24sp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnClear"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🗑️"
            android:textSize="24sp"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚙️"
            android:textSize="24sp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnDataTable"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📊"
            android:textSize="24sp"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <!-- Предельные данные -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📋 Предельные данные:"
        android:textStyle="bold"
        android:layout_marginTop="16dp" />

    <ScrollView
        android:id="@+id/limitDataScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <TableLayout
            android:id="@+id/tableLimitData"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stretchColumns="*" />

    </ScrollView>

</LinearLayout>