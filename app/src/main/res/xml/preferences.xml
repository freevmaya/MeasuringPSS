<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory android:title="Измерения">
        <EditTextPreference
            android:key="weight_cf"
            android:title="Коэффициент веса"
            android:summary="Текущее значение: 1.0"
            android:defaultValue="1.0"
            android:inputType="numberDecimal"
            android:dialogTitle="Коэффициент веса" />

        <EditTextPreference
            android:key="distance_add"
            android:title="Коррекция расстояния"
            android:summary="Текущее значение: 0 (0 - авто)"
            android:defaultValue="0"
            android:inputType="number"
            android:dialogTitle="Коррекция расстояния (мм)" />

        <EditTextPreference
            android:key="weight_limit"
            android:title="Предельный вес"
            android:summary="Текущее значение: 100.0"
            android:defaultValue="100.0"
            android:inputType="numberDecimal"
            android:dialogTitle="Предельный вес (г)" />

        <ListPreference
            android:key="measurement_method"
            android:title="Методика замера"
            android:summary="Текущая методика: 1 замер"
            android:entries="@array/measurement_method_entries"
            android:entryValues="@array/measurement_method_values"
            android:defaultValue="method_1"
            android:dialogTitle="Методика замера" />

        <EditTextPreference
            android:key="diff_threshold"
            android:title="Порог разницы"
            android:summary="Текущее значение: 20 мм (от 10 до 200)"
            android:defaultValue="20"
            android:inputType="number"
            android:dialogTitle="Порог разницы (мм)" />

        <ListPreference
            android:key="measurement_mode"
            android:title="Режим измерения"
            android:summary="Текущий режим: Одна консоль"
            android:entries="@array/measurement_mode_entries"
            android:entryValues="@array/measurement_mode_values"
            android:defaultValue="single"
            android:dialogTitle="Режим измерения" />

        <ListPreference
            android:key="correction_mode"
            android:title="Режим коррекции"
            android:summary="Текущий режим: Общая коррекция"
            android:entries="@array/correction_mode_entries"
            android:entryValues="@array/correction_mode_values"
            android:defaultValue="global"
            android:dialogTitle="Режим коррекции" />

        <SwitchPreferenceCompat
            android:key="keep_screen_on"
            android:title="Не гасить экран"
            android:summary="Экран не будет гаснуть"
            android:defaultValue="true" />
    </PreferenceCategory>
</PreferenceScreen>