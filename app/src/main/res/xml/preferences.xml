<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <EditTextPreference
        android:key="weight_cf"
        android:title="Коэффициент веса"
        android:summary="Текущее значение: %s"
        android:defaultValue="1.0"
        android:inputType="numberDecimal" />

    <EditTextPreference
        android:key="distance_add"
        android:title="Коррекция расстояния"
        android:summary="Текущее значение: %s (0 - авто)"
        android:defaultValue="0"
        android:inputType="number" />

    <!-- НОВЫЙ ПАРАМЕТР: Коррекция по рядам -->
    <SwitchPreferenceCompat
        android:key="correction_per_row"
        android:title="Коррекция по рядам"
        android:summary="Вкл. — коррекция для каждого ряда отдельно; Выкл. — одна общая коррекция"
        android:defaultValue="false" />

    <EditTextPreference
        android:key="weight_limit"
        android:title="Предел веса"
        android:summary="Текущее значение: %s"
        android:defaultValue="100.0"
        android:inputType="numberDecimal" />

    <EditTextPreference
        android:key="measurement_count"
        android:title="Количество замеров"
        android:summary="Текущее значение: %s (от 1 до 10)"
        android:defaultValue="1"
        android:inputType="number"
        android:maxLength="2" />

    <EditTextPreference
        android:key="diff_threshold"
        android:title="Порог разницы"
        android:summary="Текущее значение: %s мм (от 10 до 200)"
        android:defaultValue="20"
        android:inputType="number"
        android:maxLength="3" />

    <ListPreference
        android:key="measurement_mode"
        android:title="Режим измерения"
        android:summary="Текущий режим: %s"
        android:defaultValue="single"
        android:entries="@array/measurement_mode_entries"
        android:entryValues="@array/measurement_mode_values" />

    <SwitchPreferenceCompat
        android:key="keep_screen_on"
        android:title="Не гасить экран"
        android:summary="Экран не будет гаснуть при работе приложения"
        android:defaultValue="true" />
</PreferenceScreen>